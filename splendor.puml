        + isFinalRound() : boolean
        + isFinished() : boolean
        + toString() : String
    }

    class Game {
        - recentMoves : Deque<String>
        - undoHistory : Deque<GameSnapshot>
        - players : List<Player>
        - board : Board
        - winningPoints : int
        - maxTokens : int
        - currentState : GameState
        - currentPlayerIndex : int
        - winner : Player
        - isFinalRound : boolean
        - finalRoundPlayerIndex : int
        + Game(players : List<Player>, winningPoints : int, maxTokens : int)
        + saveUndoState() : void
        + undo() : boolean
        + getPlayers() : List<Player>
        + getCurrentPlayer() : Player
        + getBoard() : Board
        + getCurrentState() : GameState
        + getWinningPoints() : int
        + getMaxTokens() : int
        + addRecentMove(entry : String) : void
        + getRecentMoves() : List<String>
        + getWinner() : Player
        + isFinalRound() : boolean
        + isGameFinished() : boolean
        + advanceToNextPlayer() : void
        + hasPlayerReachedWinningScore() : boolean
        - startFinalRound() : void
        - determineWinner() : void
        + getGameStateSummary() : Map<String, Object>
        + toString() : String
