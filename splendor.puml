@startuml splendor

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

' ─────────────────────────────────────────────
'  PACKAGE: com.splendor
' ─────────────────────────────────────────────
package "com.splendor" {
    class Main {
        + {static} main(args : String[]) : void
        - {static} isServerMode(args : String[]) : boolean
        - {static} startConsoleMode(configProvider : IConfigProvider) : void
        - {static} startServerMode(configProvider : IConfigProvider) : void
    }
}

' ─────────────────────────────────────────────
'  PACKAGE: com.splendor.config
' ─────────────────────────────────────────────
package "com.splendor.config" {

    interface IConfigProvider {
        + loadConfiguration() : void
        + getStringProperty(key : String, defaultValue : String) : String
        + getIntProperty(key : String, defaultValue : int) : int
        + getBooleanProperty(key : String, defaultValue : boolean) : boolean
        + hasProperty(key : String) : boolean
    }

    class FileConfigProvider {
        - {static} CONFIG_FILE_PATH : String
        - properties : Properties
        + FileConfigProvider()
        + loadConfiguration() : void
        + getStringProperty(key : String, defaultValue : String) : String
        + getIntProperty(key : String, defaultValue : int) : int
        + getBooleanProperty(key : String, defaultValue : boolean) : boolean
        + hasProperty(key : String) : boolean
        - validateRequiredProperties() : void
    }

    class ConfigKeys <<final>> {
        + {static} WINNING_POINTS : String
        + {static} MAX_TOKENS : String
        + {static} SETUP_2P_GEMS : String
        + {static} SETUP_3P_GEMS : String
        + {static} SETUP_4P_GEMS : String
        + {static} SETUP_NOBLES_ADD : String
        + {static} SERVER_PORT : String
        + {static} MAX_CLIENTS : String
        + {static} CONNECTION_TIMEOUT : String
        - ConfigKeys()
    }

    class ConfigException {
        + ConfigException(message : String)
        + ConfigException(message : String, cause : Throwable)
    }

    ConfigException --|> Exception
    FileConfigProvider ..|> IConfigProvider
    FileConfigProvider --> ConfigKeys
    FileConfigProvider --> ConfigException
}

' ─────────────────────────────────────────────
'  PACKAGE: com.splendor.exception
' ─────────────────────────────────────────────
package "com.splendor.exception" as excpkg {

    class SplendorException {
        + SplendorException(message : String)
        + SplendorException(message : String, cause : Throwable)
    }

    class GameStateException {
        + GameStateException(message : String)
        + GameStateException(messageFormat : String, args : Object...)
    }

    class InsufficientTokensException {
        + InsufficientTokensException(message : String)
        + InsufficientTokensException(messageFormat : String, args : Object...)
    }

    class InvalidMoveException {
        + InvalidMoveException(message : String)
        + InvalidMoveException(messageFormat : String, args : Object...)
    }

    class InvalidPlayerActionException {
        + InvalidPlayerActionException(message : String)
        + InvalidPlayerActionException(messageFormat : String, args : Object...)
    }

    SplendorException --|> Exception
    GameStateException --|> SplendorException
    InsufficientTokensException --|> SplendorException
    InvalidMoveException --|> SplendorException
    InvalidPlayerActionException --|> SplendorException
}

