    class BotStrategy <<final>> {
        - BotStrategy()
        + {static} chooseBotMove(player : Player, game : Game) : Move
        + {static} chooseBotDiscard(player : Player, excessCount : int, game : Game) : Move
        - {static} getWeightedBonusImportance(player : Player, board : Board) : Map<Gem, Double>
        - {static} getBestAffordableCardForNoble(player : Player, board : Board, bonusImportance : Map<Gem, Double>) : Integer
        - {static} getBestAffordableReservedForNoble(player : Player, bonusImportance : Map<Gem, Double>) : Integer
        - {static} getBestAffordableVisibleId(player : Player, board : Board) : Integer
        - {static} takeGemsTowardNoble(player : Player, board : Board, bonusImportance : Map<Gem, Double>) : Move
        - {static} getAffordableReservedIds(player : Player) : List<Integer>
        - {static} getAvailableDifferentGems(board : Board) : List<Gem>
        - {static} getAvailableTwoSameGems(board : Board) : List<Gem>
    }

    ComputerPlayer --|> Player
    Game *-- Board
    Game *-- "many" Player
    Game *-- GameState
    Board *-- "many" Card
    Board *-- "many" Noble
    Player *-- "many" Card
    Player *-- "many" Noble
    Card --> Gem
    Noble --> Gem
    Move --> MoveType
    Move --> Gem
    MenuOption --> MenuAction
    Board --> Gem
    BotStrategy --> Player
    BotStrategy --> Game
    BotStrategy --> Board
    BotStrategy --> Move
    BotStrategy --> Gem
    BotStrategy --> Card
    BotStrategy --> MoveType
    BotStrategy --> Noble
}

