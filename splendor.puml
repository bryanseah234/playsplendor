        + providesDiscount() : boolean
        + getTotalCost() : int
        + requiresGem(gem : Gem) : boolean
        + toString() : String
    }

    class Noble {
        - id : int
        - points : int
        - requirements : Map<Gem, Integer>
        + Noble()
        + Noble(id : int, points : int, requirements : Map<Gem, Integer>)
        + getId() : int
        + setId(id : int) : void
        + getPoints() : int
        + setPoints(points : int) : void
        + getRequirements() : Map<Gem, Integer>
        + setRequirements(requirements : Map<Gem, Integer>) : void
        + requirementsMet(playerGemCounts : Map<Gem, Integer>) : boolean
        + getTotalRequirementCount() : int
        + toString() : String
    }

    class Player {
        - name : String
        - tokens : Map<Gem, Integer>
        - purchasedCards : List<Card>
        - reservedCards : List<Card>
        - nobles : List<Noble>
        + Player()
        + Player(name : String)
        + Player(name : String, tokens : Map<Gem, Integer>, purchasedCards : List<Card>, reservedCards : List<Card>, nobles : List<Noble>)
        - ensureTokenEntries() : void
        + getName() : String
        + setName(name : String) : void
        + getTokens() : Map<Gem, Integer>
        + setTokens(tokens : Map<Gem, Integer>) : void
        + getTokenCount(gem : Gem) : int
        + getTotalTokenCount() : int
        + getPurchasedCards() : List<Card>
        + setPurchasedCards(cards : List<Card>) : void
        + getReservedCards() : List<Card>
        + setReservedCards(cards : List<Card>) : void
        + getNobles() : List<Noble>
        + setNobles(nobles : List<Noble>) : void
        + getTotalPoints() : int
        + getGemDiscounts() : Map<Gem, Integer>
        + addTokens(gem : Gem, quantity : int) : void
        + removeTokens(gem : Gem, quantity : int) : void
        + addPurchasedCard(card : Card) : void
        + addReservedCard(card : Card) : void
        + removeReservedCard(card : Card) : boolean
        + addNoble(noble : Noble) : void
        + canReserveCard() : boolean
