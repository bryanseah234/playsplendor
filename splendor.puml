        + getPoints() : int
        + setPoints(points : int) : void
        + getBonusGem() : Gem
        + setBonusGem(bonusGem : Gem) : void
        + getCost() : Map<Gem, Integer>
        + setCost(cost : Map<Gem, Integer>) : void
