        - validateBuyCard(move : Move, player : Player, game : Game) : void
        - validateDiscardTokens(move : Move, player : Player, game : Game) : void
        + canPlayerAffordCard(player : Player, card : Card) : boolean
        - findAvailableCardById(board : Board, cardId : int) : Card
        - findReservedCardById(player : Player, cardId : int) : Card
        + validateTakeTwo(gem : Gem, board : Board) : ValidationResult
        + getRuleExplanation(move : Move, player : Player, game : Game) : ValidationResult
    }

