package "com.splendor.model" {

    enum Gem {
        RED
        GREEN
        BLUE
        WHITE
        BLACK
        GOLD
        - displayName : String
        + getDisplayName() : String
        + toString() : String
    }

    enum MoveType {
        TAKE_THREE_DIFFERENT
        TAKE_TWO_SAME
        RESERVE_CARD
        BUY_CARD
        DISCARD_TOKENS
        EXIT_GAME
        - displayName : String
        + getDisplayName() : String
        + toString() : String
    }

    enum MenuAction {
        TAKE_THREE
        TAKE_TWO
        RESERVE_VISIBLE
        RESERVE_DECK
        BUY_VISIBLE
        BUY_RESERVED
        EXIT_GAME
    }

    class MenuOption <<final>> {
        - number : int
        - action : MenuAction
        - available : boolean
        - label : String
        - detail : String
        - reason : String
