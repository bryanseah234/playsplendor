@startuml splendor_model
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam rankdir LR
skinparam shadowing false
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam padding 6
skinparam nodesep 50
skinparam ranksep 70

title Splendor — Model Layer (com.splendor.model)

enum Gem {
  WHITE / BLUE / GREEN / RED / BLACK / GOLD
  --
  +{static} values(): Gem[]
  +{static} valueOf(name: String): Gem
  +getShortCode(): String
  +getLabel(): String
  +{static} displayOrder(): List<Gem>
  +{static} displayOrderNoGold(): List<Gem>
  +toString(): String
  +{static} parseGem(input: String): Gem
  +{static} parseGemSelection(input: String): List<Gem>
}
enum MoveType {
  TAKE_THREE_DIFFERENT / TAKE_TWO_SAME
  RESERVE_CARD / BUY_CARD
  DISCARD_TOKENS / EXIT_GAME
  --
  +{static} values(): MoveType[]
  +{static} valueOf(name: String): MoveType
  +getDisplayName(): String
  +toString(): String
}
enum GameState {
  ONGOING / FINAL_ROUND / FINISHED
  --
  +{static} values(): GameState[]
  +{static} valueOf(name: String): GameState
  +getDisplayName(): String
  +toString(): String
}
enum MenuAction {
  TAKE_THREE / TAKE_TWO
  RESERVE_VISIBLE / RESERVE_DECK
  BUY_VISIBLE / BUY_RESERVED / EXIT_GAME
  --
  +{static} values(): MenuAction[]
  +{static} valueOf(name: String): MenuAction
}

class Card {
  +Card(id: int, tier: int, points: int, bonusGem: Gem, cost: Map<Gem,Integer>)
  +getId(): int
  +getTier(): int
  +getPoints(): int
  +getBonusGem(): Gem
  +getCost(): Map<Gem,Integer>
  +providesDiscount(): boolean
  +toString(): String
}
class Noble {
  +Noble(id: int, points: int, requirements: Map<Gem,Integer>)
  +getId(): int
  +getPoints(): int
  +getRequirements(): Map<Gem,Integer>
  +requirementsMet(playerGemCounts: Map<Gem,Integer>): boolean
  +toString(): String
}
class Player {
  +Player(name: String)
  +Player(name: String, tokens: Map<Gem,Integer>, purchasedCards: List<Card>, reservedCards: List<Card>, nobles: List<Noble>)
  +getName(): String
  +getTokens(): Map<Gem,Integer>
  +getTokenCount(gem: Gem): int
  +getTotalTokenCount(): int
  +getPurchasedCards(): List<Card>
  +getReservedCards(): List<Card>
  +getNobles(): List<Noble>
  +getTotalPoints(): int
  +getGemDiscounts(): Map<Gem,Integer>
  +addTokens(gem: Gem, quantity: int): void
  +removeTokens(gem: Gem, quantity: int): void
  +addPurchasedCard(card: Card): void
  +addReservedCard(card: Card): void
  +removeReservedCard(card: Card): boolean
  +addNoble(noble: Noble): void
  +canReserveCard(maxReserved: int): boolean
  +toString(): String
}
class ComputerPlayer {
  +ComputerPlayer(name: String)
}
class Move {
  +Move(moveType: MoveType)
  +Move(moveType: MoveType, selectedGems: Map<Gem,Integer>)
  +Move(moveType: MoveType, cardId: Integer, isReservedCard: boolean)
  +Move(moveType: MoveType, selectedGems: Map<Gem,Integer>, cardId: Integer, isReservedCard: boolean, deckTier: Integer)
  +{static} reserveFromDeck(tier: int): Move
  +getMoveType(): MoveType
  +getSelectedGems(): Map<Gem,Integer>
  +getCardId(): Integer
  +isReservedCard(): boolean
  +getDeckTier(): Integer
  +hasCardSelection(): boolean
  +hasDeckSelection(): boolean
  +hasGemSelection(): boolean
  +toString(): String
}
class Board {
  +Board(maxPlayers: int, config: IConfigProvider)
  +getGemBank(): Map<Gem,Integer>
  +getGemCount(gem: Gem): int
  +getAvailableCards(): Map<Integer,List<Card>>
  +getAvailableCards(tier: int): List<Card>
  +getDeckSize(tier: int): int
  +getAvailableNobles(): List<Noble>
  +removeGems(gems: Map<Gem,Integer>): void
  +addGems(gems: Map<Gem,Integer>): void
  +drawCard(tier: int): Card
  +drawBlindCard(tier: int): Card
  +removeAvailableCard(tier: int, card: Card): boolean
  +copyDecks(): Map<Integer,List<Card>>
  +restoreDecks(decks: Map<Integer,List<Card>>): void
  +removeAvailableNoble(noble: Noble): boolean
  +toString(): String
}
class Game {
  +Game(players: List<Player>, winningPoints: int, maxTokens: int, config: IConfigProvider)
  +saveUndoState(): void
  +undo(): boolean
  +getPlayers(): List<Player>
  +getCurrentPlayer(): Player
  +getBoard(): Board
  +getCurrentState(): GameState
  +getWinningPoints(): int
  +getMaxTokens(): int
  +addRecentMove(entry: String): void
  +getRecentMoves(): List<String>
  +getWinner(): Player
  +isFinalRound(): boolean
  +isGameFinished(): boolean
  +advanceToNextPlayer(): void
  +hasPlayerReachedWinningScore(): boolean
  +toString(): String
}
class MenuOption {
  +MenuOption(number: int, action: MenuAction, available: boolean, label: String, detail: String, reason: String)
  +getNumber(): int
  +getAction(): MenuAction
  +isAvailable(): boolean
  +getLabel(): String
  +getDetail(): String
  +getReason(): String
}

Player <|-- ComputerPlayer
Game "1" *-- "1" Board
Game "1" *-- "1..*" Player
Game --> GameState : currentState
Player "1" *-- "0..*" Card : purchasedCards / reservedCards
Player "1" *-- "0..*" Noble : nobles
Board "1" *-- "0..*" Card : availableCards
Board "1" *-- "0..*" Noble : availableNobles
Move --> MoveType
MenuOption --> MenuAction
Card --> Gem : bonusGem

@enduml
