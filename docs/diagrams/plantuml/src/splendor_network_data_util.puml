@startuml splendor_network_data_util
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam rankdir LR
skinparam shadowing false
skinparam defaultFontSize 10
skinparam classAttributeIconSize 0
skinparam padding 3

title Splendor — Network, Data and Util Packages

package "com.splendor.network" {
  interface NetworkMessageHandler {
    +sendToClient(clientId: String, message: String): void
    +waitForClientResponse(clientId: String, timeoutMs: int): String
  }
  class ServerSocketHandler {
    +ServerSocketHandler()
    +startServer(): void
    +waitForAtLeastClients(targetClients: int, timeoutMs: long): boolean
    +getConnectedClientIds(): List<String>
    +isClientConnected(clientId: String): boolean
    +broadcastToAllClients(message: String): void
    +sendToClient(clientId: String, message: String): void
    +waitForClientResponse(clientId: String, timeoutMs: int): String
    +stopServer(): void
    +getConnectedClientCount(): int
    +getActualPort(): int
    +setGameStarted(started: boolean): void
  }
  class ClientHandler {
    +ClientHandler(clientSocket: Socket, serverHandler: ServerSocketHandler)
    +handleClient(): void
    +sendMessage(message: String): void
    +disconnect(): void
    +getClientId(): String
  }
  NetworkMessageHandler <|.. ServerSocketHandler
  ServerSocketHandler "1" *-- "0..4" ClientHandler : connectedClients
}

package "com.splendor.data" {
  class CardLoader {
    +{static} loadCards(tier: int): List<Card>
    +{static} loadNobles(): List<Noble>
  }
  class CsvCardParser {
    +CsvCardParser(configProvider: IConfigProvider)
    +loadCards(tier: int): List<Card>
    +loadNobles(): List<Noble>
  }
  CardLoader ..> CsvCardParser : creates / uses
}

package "com.splendor.util" {
  class AnsiUtils {
    +{static} stripAnsi(str: String): String
    +{static} padRightAnsi(s: String, visibleWidth: int): String
    +{static} truncateAnsi(s: String, maxVisible: int): String
    +{static} combineHorizontal(blocks: List<List<String>>, gap: int): List<String>
  }
  class GameLogger {
    +{static} LOG_FORMAT: String
    +{static} LOG_LEVEL_INFO: String
    +{static} LOG_LEVEL_ERROR: String
    +{static} LOG_LEVEL_DEBUG: String
    +{static} LOG_LEVEL_WARN: String
    +{static} setDebugEnabled(enabled: boolean): void
    +{static} info(message: String): void
    +{static} error(message: String): void
    +{static} error(message: String, exception: Throwable): void
    +{static} debug(message: String): void
    +{static} warn(message: String): void
  }
  class InputResolver {
    +InputResolver()
    +promptForInt(prompt: String, minValue: int, maxValue: int): int
    +promptForInt(prompt: String, minValue: int, maxValue: int, onInvalid: Runnable): int
    +promptForString(prompt: String, minLength: int, maxLength: int): String
    +close(): void
  }
  class MoveFormatter {
    +{static} formatMoveEntry(player: Player, move: Move): String
    +{static} formatGemCounts(counts: Map<Gem,Integer>): String
  }
}
@enduml
