@startuml splendor_packages
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam rankdir LR
skinparam shadowing false
skinparam defaultFontSize 11
skinparam padding 2
skinparam packageStyle rectangle
skinparam nodesep 20
skinparam ranksep 30

title Splendor — Package Overview

package "com.splendor" #LightYellow {
  class Main
}

package "com.splendor.config" #LightBlue {
  interface IConfigProvider
  class FileConfigProvider
  class ConfigValidator
  class ConfigKeys
}

package "com.splendor.exception" #MistyRose {
  class SplendorException
  class GameStateException
  class InsufficientTokensException
  class InvalidMoveException
  class InvalidPlayerActionException
  class NetworkException
  class ConfigException
  class DataLoadException
}

package "com.splendor.model" #LightGreen {
  class Player
  class ComputerPlayer
  class Card
  class Noble
  enum Gem
  class Move
  enum MoveType
  class Board
  class Game
  enum GameState
  enum MenuAction
  class MenuOption
}

package "com.splendor.model.validator" #PaleGreen {
  class GameRuleValidator
  class MoveValidator
  class ValidationResult
}

package "com.splendor.controller" #LightCoral {
  class GameController
  class TurnController
  class PlayerController
  class BotStrategy
  class MenuBuilder
}

package "com.splendor.view" #LightCyan {
  interface IGameView
  class ConsoleView
  class GameRenderer
  class CardRenderer
  class NetworkGameView
  class RemoteView
  class Colors
}

package "com.splendor.network" #Lavender {
  interface NetworkMessageHandler
  class ServerSocketHandler
  class ClientHandler
}

package "com.splendor.data" #Wheat {
  class CardLoader
  class CsvCardParser
}

package "com.splendor.util" #LightGray {
  class AnsiUtils
  class GameLogger
  class InputResolver
  class MoveFormatter
}

' Package-level dependency arrows
Main ..> "com.splendor.config" : uses
Main ..> "com.splendor.controller" : creates
Main ..> "com.splendor.network" : creates (server mode)
"com.splendor.config" ..> "com.splendor.exception" : throws
"com.splendor.controller" ..> "com.splendor.model" : manages
"com.splendor.controller" ..> "com.splendor.view" : uses
"com.splendor.controller" ..> "com.splendor.model.validator" : uses
"com.splendor.view" ..> "com.splendor.network" : uses (remote)
"com.splendor.view" ..> "com.splendor.util" : uses
"com.splendor.model" ..> "com.splendor.data" : loads
"com.splendor.model" ..> "com.splendor.config" : reads
"com.splendor.data" ..> "com.splendor.exception" : throws
"com.splendor.network" ..> "com.splendor.exception" : throws

@enduml
