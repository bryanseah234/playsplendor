@startuml splendor_controller
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam rankdir LR
skinparam shadowing false
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam padding 6
skinparam nodesep 50
skinparam ranksep 70

title Splendor — Controller Layer (com.splendor.controller)

package "com.splendor.controller" {
  class GameController {
    +GameController(gameView: IGameView, configProvider: IConfigProvider)
    +initializeGame(): void
    +startGame(): void
    +getGame(): Game
    +getPlayers(): List<Player>
  }
  class TurnController {
    +TurnController(game: Game, gameView: IGameView)
    +executeMove(move: Move, player: Player): void
  }
  class PlayerController {
    +PlayerController(game: Game, gameView: IGameView, moveValidator: MoveValidator)
    +checkNobleVisits(player: Player): void
    +executeTokenDiscard(player: Player, discardMove: Move): void
  }
  class BotStrategy {
    +{static} chooseBotMove(player: Player, game: Game, moveValidator: MoveValidator): Move
    +{static} chooseBotDiscard(player: Player, excessCount: int, game: Game): Move
  }
  class MenuBuilder {
    +{static} buildMenuOptions(player: Player, game: Game, moveValidator: MoveValidator): List<MenuOption>
    +{static} formatColoredGemList(gems: List<Gem>): String
    +{static} formatIdList(ids: List<Integer>, maxCount: int): String
    +{static} getAvailableDifferentGems(board: Board): List<Gem>
    +{static} getAvailableTwoSameGems(board: Board): List<Gem>
    +{static} hasVisibleCards(board: Board): boolean
    +{static} hasAnyDeckCards(board: Board): boolean
    +{static} getAffordableVisibleIds(player: Player, board: Board, moveValidator: MoveValidator): List<Integer>
    +{static} getAffordableReservedIds(player: Player, moveValidator: MoveValidator): List<Integer>
    +{static} getVisibleCardIds(board: Board): List<Integer>
    +{static} getReservedCardIds(player: Player): List<Integer>
  }
}

package "com.splendor.view" {
  interface IGameView
}
package "com.splendor.model" {
  class Game
  class Player
  class Move
  class Board
  class MenuOption
}
package "com.splendor.model.validator" {
  class MoveValidator
  class GameRuleValidator
}

GameController --> IGameView : uses
GameController --> Game : manages
GameController --> MoveValidator : uses
GameController --> GameRuleValidator : uses
GameController ..> TurnController : creates
GameController ..> PlayerController : creates
GameController ..> BotStrategy : uses
GameController ..> MenuBuilder : uses
TurnController --> Game : uses
TurnController --> IGameView : uses
PlayerController --> Game : uses
PlayerController --> IGameView : uses
PlayerController --> GameRuleValidator : uses
PlayerController --> MoveValidator : uses

@enduml
