@startuml splendor_view
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam rankdir LR
skinparam shadowing false
skinparam defaultFontSize 10
skinparam classAttributeIconSize 0
skinparam padding 3

title Splendor — View Layer (com.splendor.view)

package "com.splendor.view" {
  interface IGameView {
    +displayGameState(game: Game): void
    +displayPlayerTurn(player: Player): void
    +displayMessage(message: String): String
    +displayNotification(message: String): void
    +displayError(errorMessage: String): String
    +promptForCommand(player: Player, game: Game): String
    +promptForMove(player: Player, game: Game, options: List<MenuOption>): Move
    +promptForTokenDiscard(player: Player, excessCount: int): Move
    +displayWinner(winner: Player, finalScores: Map<String,Integer>): void
    +clearDisplay(): void
    +displayAvailableMoves(options: List<MenuOption>, game: Game): void
    +promptForNobleChoice(player: Player, nobles: List<Noble>): Noble
    +promptForPlayerName(playerNumber: int, totalPlayers: int): String
    +promptForPlayerCount(): int
    +displayWelcomeMessage(): void
    +waitForEnter(): String
    +close(): void
  }
  class ConsoleView {
    +ConsoleView(config: IConfigProvider)
    +displayGameState(game: Game): void
    +displayPlayerTurn(player: Player): void
    +displayMessage(message: String): String
    +displayNotification(message: String): void
    +displayError(errorMessage: String): String
    +waitForEnter(): String
    +promptForCommand(player: Player, game: Game): String
    +promptForMove(player: Player, game: Game, options: List<MenuOption>): Move
    +promptForTokenDiscard(player: Player, excessCount: int): Move
    +displayWinner(winner: Player, finalScores: Map<String,Integer>): void
    +clearDisplay(): void
    +displayAvailableMoves(options: List<MenuOption>, game: Game): void
    +promptForNobleChoice(player: Player, nobles: List<Noble>): Noble
    +promptForPlayerName(playerNumber: int, totalPlayers: int): String
    +promptForPlayerCount(): int
    +displayWelcomeMessage(): void
    +close(): void
  }
  class GameRenderer {
    +GameRenderer(config: IConfigProvider)
    +clearDisplay(): void
    +displayGameState(game: Game): void
    +renderToString(game: Game): String
    +displayPlayerTokens(player: Player): void
    +setMenuLines(menuLines: List<String>): void
    +buildMenuLines(options: List<MenuOption>, winningPoints: int): List<String>
  }
  class CardRenderer {
    +{static} formatCardAscii(card: Card): String
    +{static} formatCardAscii(card: Card, affordable: boolean): String
  }
  class NetworkGameView {
    +NetworkGameView(playerViews: List<RemoteView>, playerCount: int)
    +NetworkGameView(playerViews: List<RemoteView>, playerCount: int, predefinedPlayerNames: List<String>)
    +displayGameState(game: Game): void
    +displayPlayerTurn(player: Player): void
    +displayMessage(message: String): String
    +displayNotification(message: String): void
    +displayError(errorMessage: String): String
    +displayWinner(winner: Player, finalScores: Map<String,Integer>): void
    +displayAvailableMoves(options: List<MenuOption>, game: Game): void
    +displayWelcomeMessage(): void
    +clearDisplay(): void
    +close(): void
    +waitForEnter(): String
    +promptForCommand(player: Player, game: Game): String
    +promptForMove(player: Player, game: Game, options: List<MenuOption>): Move
    +promptForTokenDiscard(player: Player, excessCount: int): Move
    +promptForNobleChoice(player: Player, nobles: List<Noble>): Noble
    +promptForPlayerCount(): int
    +promptForPlayerName(playerNumber: int, totalPlayers: int): String
  }
  class RemoteView {
    +RemoteView(clientId: String, messageHandler: NetworkMessageHandler, config: IConfigProvider)
    +displayGameState(game: Game): void
    +displayPlayerTurn(player: Player): void
    +displayMessage(message: String): String
    +displayError(errorMessage: String): String
    +displayNotification(message: String): void
    +promptForCommand(player: Player, game: Game): String
    +promptForMove(player: Player, game: Game, options: List<MenuOption>): Move
    +promptForTokenDiscard(player: Player, excessCount: int): Move
    +displayWinner(winner: Player, finalScores: Map<String,Integer>): void
    +clearDisplay(): void
    +displayAvailableMoves(options: List<MenuOption>, game: Game): void
    +promptForNobleChoice(player: Player, nobles: List<Noble>): Noble
    +promptForPlayerName(playerNumber: int, totalPlayers: int): String
    +promptForPlayerCount(): int
    +displayWelcomeMessage(): void
    +waitForEnter(): String
    +close(): void
  }
  class Colors {
    +{static} RESET: String
    +{static} RED: String
    +{static} GREEN: String
    +{static} BLUE: String
    +{static} WHITE: String
    +{static} BLACK: String
    +{static} GOLD: String
    +{static} CYAN: String
    +{static} PURPLE: String
    +{static} GRAY: String
    +{static} DIM: String
    +Colors()
    +{static} colorize(text: String, colorCode: String): String
    +{static} getGemColor(gem: Gem): String
  }
}
package "com.splendor.network" {
  interface NetworkMessageHandler
}
package "com.splendor.util" {
  class InputResolver
}

IGameView <|.. ConsoleView
IGameView <|.. NetworkGameView
IGameView <|.. RemoteView
ConsoleView --> GameRenderer : uses
ConsoleView --> InputResolver : uses
NetworkGameView "1" *-- "1..*" RemoteView : playerViews
RemoteView --> GameRenderer : uses
RemoteView --> NetworkMessageHandler : uses
GameRenderer --> CardRenderer : uses
GameRenderer --> Colors : uses
CardRenderer --> Colors : uses
@enduml
