' Cross-package
Main --> IConfigProvider : uses
Main --> GameController : creates
Main --> ServerSocketHandler : creates (server mode)
GameController --> IGameView : uses
GameController --> Game : manages
GameController --> MoveValidator : uses
GameController --> GameRuleValidator : uses
GameController ..> TurnController : creates
GameController ..> PlayerController : creates
GameController ..> BotStrategy : uses
GameController ..> MenuBuilder : uses
TurnController --> Game
TurnController --> IGameView
PlayerController --> Game
PlayerController --> IGameView
PlayerController --> GameRuleValidator
PlayerController --> MoveValidator
RemoteView --> NetworkMessageHandler
Board ..> CardLoader : uses
ConfigValidator ..> CardLoader : uses
ConsoleView --> InputResolver
GameRenderer --> Colors
CardRenderer --> Colors
MoveFormatter --> Colors
@enduml
