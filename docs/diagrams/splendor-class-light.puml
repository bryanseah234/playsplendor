@startuml splendor_class_light

title Splendor Class Diagram (Lightweight)

left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam monochrome false
hide empty members

package "com.splendor" {
  class Main
}

package "com.splendor.config" {
  interface IConfigProvider
  class FileConfigProvider
  class ConfigKeys
  class ConfigValidator
  class ConfigException
}

package "com.splendor.exception" {
  class SplendorException
  class DataLoadException
  class NetworkException
  class GameStateException
  class InsufficientTokensException
  class InvalidMoveException
  class InvalidPlayerActionException
}

package "com.splendor.controller" {
  class GameController
  class TurnController
  class PlayerController
  class MenuBuilder
  class BotStrategy
}

package "com.splendor.model" {
  class Game
  class Board
  class Player
  class ComputerPlayer
  class Card
  class Noble
  class Move
  class GameState
  enum Gem
  enum MoveType
  enum MenuAction
  class MenuOption
}

package "com.splendor.data" {
  class CsvCardParser
  class CardLoader
}

package "com.splendor.model.validator" {
  class MoveValidator
  class GameRuleValidator
  class ValidationResult
}

package "com.splendor.view" {
  interface IGameView
  class Colors
  class CardRenderer
  class ConsoleView
  class NetworkGameView
  class RemoteView
  class GameRenderer
}

package "com.splendor.network" {
  class ServerSocketHandler
  class ClientHandler
  interface NetworkMessageHandler
}

package "com.splendor.util" {
  class GameLogger
  class AnsiUtils
  class InputResolver
  class MoveFormatter
}

' Core inheritance / interfaces
FileConfigProvider ..|> IConfigProvider
FileConfigProvider --> ConfigKeys
FileConfigProvider --> ConfigException
ComputerPlayer --|> Player
ConsoleView ..|> IGameView
NetworkGameView ..|> IGameView
RemoteView ..|> IGameView
ServerSocketHandler ..|> NetworkMessageHandler

' Core model composition
Game *-- Board
Game *-- "many" Player
Game *-- GameState
Board *-- "many" Card
Board *-- "many" Noble
Player *-- "many" Card
Player *-- "many" Noble
Move --> MoveType
Move --> Gem
MenuOption --> MenuAction
Board --> Gem
BotStrategy --> Player
BotStrategy --> Game
BotStrategy --> Board
BotStrategy --> Move
BotStrategy --> Gem
BotStrategy --> Card
BotStrategy --> MoveType
BotStrategy --> Noble
BotStrategy --> MoveValidator

' Controller dependencies
GameController --> IGameView
GameController --> IConfigProvider
GameController --> Game
GameController --> MoveValidator
GameController --> GameRuleValidator
GameController --> TurnController
GameController --> PlayerController
GameController --> MenuBuilder

TurnController --> Game
TurnController --> IGameView
PlayerController --> Game
PlayerController --> IGameView
MenuBuilder --> MoveValidator

' View/network wiring
NetworkGameView *-- "many" RemoteView
RemoteView --> GameRenderer
RemoteView --> NetworkMessageHandler
Colors --> Gem
CardRenderer --> Card
CardRenderer --> Gem
CardRenderer --> Colors

' App entry wiring
Main --> GameController
Main --> IConfigProvider
Main --> IGameView
Main --> ServerSocketHandler

' Network internals (high level)
ServerSocketHandler *-- "many" ClientHandler
ClientHandler --> ServerSocketHandler

@enduml
