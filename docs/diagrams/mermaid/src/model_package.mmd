classDiagram
    direction LR
    class Board {
        -List~Noble~ availableNobles
        -int maxPlayers
        -IConfigProvider config
        +Board(int maxPlayers, IConfigProvider config)
        +getGemCount(Gem gem) int
        +getAvailableCards(int tier) List~Card~
        +getDeckSize(int tier) int
        +getAvailableNobles() List~Noble~
        +removeGems(Map~Gem, Integer~ gems) void
        +addGems(Map~Gem, Integer~ gems) void
        +drawCard(int tier) Card
        +drawBlindCard(int tier) Card
        +removeAvailableCard(int tier, Card card) boolean
        +restoreDecks(Map~Integer, List~Card~~ decks) void
        -ensureTierSlotsPresent() void
        +removeAvailableNoble(Noble noble) boolean
        -initializeGemBank() void
        -initializeCardDecks() void
        -initializeAvailableCards() void
        -initializeNobles() void
        -getBaseGemCountForPlayers(int playerCount) int
        +toString() String
    }

    class Card {
        -int id
        -int tier
        -int points
        -Gem bonusGem
        +Card(int id, int tier, int points, Gem bonusGem, Map~Gem, Integer~ cost)
        +getId() int
        +getTier() int
        +getPoints() int
        +getBonusGem() Gem
        +providesDiscount() boolean
        +toString() String
    }

    class ComputerPlayer {
        +ComputerPlayer(String name)
    }

    ComputerPlayer --|> Player
    class Game {
        -Deque~String~ recentMoves
        -Deque~GameSnapshot~ undoHistory
        -List~Player~ players
        -Board board
        -int winningPoints
        -int maxTokens
        -GameState currentState
        -int currentPlayerIndex
        -Player winner
        -boolean isFinalRound
        -int finalRoundPlayerIndex
        +saveUndoState() void
        +undo() boolean
        +getPlayers() List~Player~
        +getCurrentPlayer() Player
        +getBoard() Board
        +getCurrentState() GameState
        +getWinningPoints() int
        +getMaxTokens() int
        +addRecentMove(String entry) void
        +getRecentMoves() List~String~
        +getWinner() Player
        +isFinalRound() boolean
        +isGameFinished() boolean
        +advanceToNextPlayer() void
        +hasPlayerReachedWinningScore() boolean
        -startFinalRound() void
        -determineWinner() void
        +toString() String
    }

    class GameState {
        <<enumeration>>
        ONGOING
        FINAL_ROUND
        FINISHED
        -String displayName
        +getDisplayName() String
        +toString() String
    }

    class Gem {
        <<enumeration>>
        WHITE
        BLUE
        GREEN
        RED
        BLACK
        GOLD
        -String shortCode
        -String label
        +getShortCode() String
        +getLabel() String
        +toString() String
        +parseGem(String input) Gem$
        +parseGemSelection(String input) List~Gem~$
    }

    class MenuAction {
        <<enumeration>>
        TAKE_THREE
        TAKE_TWO
        RESERVE_VISIBLE
        RESERVE_DECK
        BUY_VISIBLE
        BUY_RESERVED
        EXIT_GAME
    }

    class MenuOption {
        -int number
        -MenuAction action
        -boolean available
        -String label
        -String detail
        -String reason
        +getNumber() int
        +getAction() MenuAction
        +isAvailable() boolean
        +getLabel() String
        +getDetail() String
        +getReason() String
    }

    class Move {
        -MoveType moveType
        -Integer cardId
        -boolean isReservedCard
        -Integer deckTier
        +Move(MoveType moveType)
        +Move(MoveType moveType, Map~Gem, Integer~ selectedGems)
        +Move(MoveType moveType, Integer cardId, boolean isReservedCard)
        +reserveFromDeck(int tier) Move$
        +getMoveType() MoveType
        +getCardId() Integer
        +isReservedCard() boolean
        +getDeckTier() Integer
        +hasCardSelection() boolean
        +hasDeckSelection() boolean
        +hasGemSelection() boolean
        +toString() String
    }

    class MoveType {
        <<enumeration>>
        TAKE_THREE_DIFFERENT
        TAKE_TWO_SAME
        RESERVE_CARD
        BUY_CARD
        DISCARD_TOKENS
        EXIT_GAME
        -String displayName
        +getDisplayName() String
        +toString() String
    }

    class Noble {
        -int id
        -int points
        +Noble(int id, int points, Map~Gem, Integer~ requirements)
        +getId() int
        +getPoints() int
        +requirementsMet(Map~Gem, Integer~ playerGemCounts) boolean
        +toString() String
    }

    class Player {
        -String name
        -List~Card~ purchasedCards
        -List~Card~ reservedCards
        -List~Noble~ nobles
        +Player(String name)
        -ensureTokenEntries() void
        +getName() String
        +getTokenCount(Gem gem) int
        +getTotalTokenCount() int
        +getPurchasedCards() List~Card~
        +getReservedCards() List~Card~
        +getNobles() List~Noble~
        +getTotalPoints() int
        +addTokens(Gem gem, int quantity) void
        +removeTokens(Gem gem, int quantity) void
        +addPurchasedCard(Card card) void
        +addReservedCard(Card card) void
        +removeReservedCard(Card card) boolean
        +addNoble(Noble noble) void
        +canReserveCard(int maxReserved) boolean
        +toString() String
    }

    Board --> Noble
    Board --> Player
    Card --> Gem
    Game --> Move
    Game --> Player
    Game --> Board
    Game --> GameState
    MenuOption --> MenuAction
    Move --> MoveType
    Move --> Card
    Player --> Card
    Player --> Noble
