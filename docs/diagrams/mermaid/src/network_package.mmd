classDiagram
    direction LR
    class ClientHandler {
        -String clientId
        -Socket clientSocket
        -ServerSocketHandler serverHandler
        -BufferedReader inputReader
        -PrintWriter outputWriter
        +ClientHandler(final Socket clientSocket, final ServerSocketHandler serverHandler)
        +handleClient() void
        -initializeStreams() void
        -processClientMessages() void
        -processMessage(final String message) void
        -sendError(final String errorMessage) void
        +sendMessage(final String message) void
        +disconnect() void
        -cleanup() void
        +getClientId() String
    }

    class NetworkMessageHandler {
        <<interface>>
    }

    class ServerSocketHandler {
        -ServerSocket serverSocket
        -ExecutorService clientExecutor
        -List~ClientHandler~ connectedClients
        +ServerSocketHandler()
        +startServer() void
        -acceptClientConnections() void
        -handleClientConnection(final Socket clientSocket) void
        +waitForAtLeastClients(final int targetClients, final long timeoutMs) boolean
        +getConnectedClientIds() List~String~
        +isClientConnected(final String clientId) boolean
        -removeClient(final ClientHandler clientHandler) void
        +broadcastToAllClients(final String message) void
        +sendToClient(final String clientId, final String message) void
        +waitForClientResponse(final String clientId, final int timeoutMs) String
        +stopServer() void
        +getConnectedClientCount() int
        +getActualPort() int
        +setGameStarted(final boolean started) void
        -closeSocket(final Socket socket) void
    }

    ServerSocketHandler ..|> NetworkMessageHandler
    ClientHandler --> ServerSocketHandler
    ServerSocketHandler --> ClientHandler
