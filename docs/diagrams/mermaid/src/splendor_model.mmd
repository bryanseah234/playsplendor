%%{init: {"theme": "default", "classDiagram": {"nodeSpacing": 20, "rankSpacing": 30}}}%%
---
title: Splendor — Model Layer (com.splendor.model)
---
classDiagram
  direction LR

  class Gem {
    <<enumeration>>
    WHITE BLUE GREEN RED BLACK GOLD
    +getShortCode() String
    +getLabel() String
    +displayOrder()$ List~Gem~
    +displayOrderNoGold()$ List~Gem~
    +toString() String
    +parseGem(input String)$ Gem
    +parseGemSelection(input String)$ List~Gem~
  }
  class MoveType {
    <<enumeration>>
    TAKE_THREE_DIFFERENT TAKE_TWO_SAME RESERVE_CARD BUY_CARD DISCARD_TOKENS EXIT_GAME
    +getDisplayName() String
    +toString() String
  }
  class GameState {
    <<enumeration>>
    ONGOING FINAL_ROUND FINISHED
    +getDisplayName() String
    +toString() String
  }
  class MenuAction {
    <<enumeration>>
    TAKE_THREE TAKE_TWO RESERVE_VISIBLE RESERVE_DECK BUY_VISIBLE BUY_RESERVED EXIT_GAME
  }
  class Card {
    +Card(id int, tier int, points int, bonusGem Gem, cost Map)
    +getId() int
    +getTier() int
    +getPoints() int
    +getBonusGem() Gem
    +getCost() Map~Gem_Integer~
    +providesDiscount() boolean
    +toString() String
  }
  class Noble {
    +Noble(id int, points int, requirements Map)
    +getId() int
    +getPoints() int
    +getRequirements() Map~Gem_Integer~
    +requirementsMet(playerGemCounts Map) boolean
    +toString() String
  }
  class Player {
    +Player(name String)
    +Player(name String, tokens Map, purchasedCards List, reservedCards List, nobles List)
    +getName() String
    +getTokens() Map~Gem_Integer~
    +getTokenCount(gem Gem) int
    +getTotalTokenCount() int
    +getPurchasedCards() List~Card~
    +getReservedCards() List~Card~
    +getNobles() List~Noble~
    +getTotalPoints() int
    +getGemDiscounts() Map~Gem_Integer~
    +addTokens(gem Gem, quantity int) void
    +removeTokens(gem Gem, quantity int) void
    +addPurchasedCard(card Card) void
    +addReservedCard(card Card) void
    +removeReservedCard(card Card) boolean
    +addNoble(noble Noble) void
    +canReserveCard(maxReserved int) boolean
    +toString() String
  }
  class ComputerPlayer {
    +ComputerPlayer(name String)
  }
  class Move {
    +Move(moveType MoveType)
    +Move(moveType MoveType, selectedGems Map)
    +Move(moveType MoveType, cardId Integer, isReservedCard boolean)
    +Move(moveType MoveType, selectedGems Map, cardId Integer, isReservedCard boolean, deckTier Integer)
    +reserveFromDeck(tier int)$ Move
    +getMoveType() MoveType
    +getSelectedGems() Map~Gem_Integer~
    +getCardId() Integer
    +isReservedCard() boolean
    +getDeckTier() Integer
    +hasCardSelection() boolean
    +hasDeckSelection() boolean
    +hasGemSelection() boolean
    +toString() String
  }
  class Board {
    +Board(maxPlayers int, config IConfigProvider)
    +getGemBank() Map~Gem_Integer~
    +getGemCount(gem Gem) int
    +getAvailableCards() Map~Integer_List~
    +getAvailableCards(tier int) List~Card~
    +getDeckSize(tier int) int
    +getAvailableNobles() List~Noble~
    +removeGems(gems Map) void
    +addGems(gems Map) void
    +drawCard(tier int) Card
    +drawBlindCard(tier int) Card
    +removeAvailableCard(tier int, card Card) boolean
    +copyDecks() Map~Integer_List~
    +restoreDecks(decks Map) void
    +removeAvailableNoble(noble Noble) boolean
    +toString() String
  }
  class Game {
    +Game(players List, winningPoints int, maxTokens int, config IConfigProvider)
    +saveUndoState() void
    +undo() boolean
    +getPlayers() List~Player~
    +getCurrentPlayer() Player
    +getBoard() Board
    +getCurrentState() GameState
    +getWinningPoints() int
    +getMaxTokens() int
    +addRecentMove(entry String) void
    +getRecentMoves() List~String~
    +getWinner() Player
    +isFinalRound() boolean
    +isGameFinished() boolean
    +advanceToNextPlayer() void
    +hasPlayerReachedWinningScore() boolean
    +toString() String
  }
  class MenuOption {
    +MenuOption(number int, action MenuAction, available boolean, label String, detail String, reason String)
    +getNumber() int
    +getAction() MenuAction
    +isAvailable() boolean
    +getLabel() String
    +getDetail() String
    +getReason() String
  }

  Player <|-- ComputerPlayer
  Game *-- "1" Board
  Game *-- "1..*" Player
  Game --> GameState : currentState
  Player *-- "0..*" Card : purchasedCards / reservedCards
  Player *-- "0..*" Noble : nobles
  Board *-- "0..*" Card : availableCards
  Board *-- "0..*" Noble : availableNobles
  Move --> MoveType
  MenuOption --> MenuAction
  Card --> Gem : bonusGem
